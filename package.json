{
  "name": "aji-tradicion",
  "version": "1.0.0",
  "description": "Landing y tienda del recetario digital Ají Tradición (100 recetas peruanas) sobre Cloudflare Workers + Mercado Pago.",
  "main": "worker/index.js",
  "scripts": {
    "build": "node scripts/build-site.js",
    "build:pages": "node scripts/build-site.js --target pages",
    "dev": "npm run build && wrangler dev --var PAYMENT_MODE:demo --var DOWNLOAD_SECRET:solo-para-desarrollo-local",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualgroup-pe/Aji-Tradicion.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/visualgroup-pe/Aji-Tradicion/issues"
  },
  "homepage": "https://github.com/visualgroup-pe/Aji-Tradicion#readme",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  }
}
