# ======================================================
#  Ají Tradición — configuración (copia a .env)
# ======================================================
NODE_ENV=production
PORT=3000
# URL pública del sitio (https, sin "/" final). Mercado Pago la usa para
# volver a /gracias y para enviar los webhooks.
BASE_URL=https://www.tudominio.pe

# ---------- Producto ----------
PRICE_PEN=29.90
# Solo si de verdad vendiste antes a ese precio (se muestra tachado):
# COMPARE_PRICE_PEN=49.90

# ---------- PDF privado ----------
# Ruta al PDF original. NUNCA dentro de /public. Puede ser absoluta.
PDF_PATH=private/recetario-100-recetas-peruanas.pdf
PDF_DOWNLOAD_NAME=Aji-Tradicion-100-recetas-peruanas.pdf
# Vigencia y límite del enlace de descarga
DOWNLOAD_TTL_HOURS=72
DOWNLOAD_MAX=5
# Secreto para firmar los enlaces (si no se define, se genera en DATA_DIR)
# DOWNLOAD_SECRET=pon-aqui-una-cadena-larga-y-aleatoria

# ---------- Pagos ----------
# mercadopago = pagos reales | demo = pagos simulados (solo desarrollo)
PAYMENT_MODE=mercadopago
# Mercado Pago > Tus integraciones > Credenciales de producción > Access Token
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Mercado Pago > Tus integraciones > Webhooks > Clave secreta
MP_WEBHOOK_SECRET=
# Texto que aparece en el estado de cuenta de la tarjeta (máx. 22)
MP_STATEMENT_DESCRIPTOR=AJITRADICION

# ---------- Datos ----------
DATA_DIR=data

# ---------- Correo (opcional pero recomendado) ----------
# Si se configura, el enlace de descarga también se envía por correo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ají Tradición <hola@tudominio.pe>"

# ---------- Datos del negocio ----------
CONTACT_EMAIL=hola@tudominio.pe
CONTACT_WHATSAPP=
BUSINESS_NAME=Ají Tradición
BUSINESS_RUC=
# URL de tu Libro de Reclamaciones virtual (obligatorio en Perú)
COMPLAINTS_BOOK_URL=
